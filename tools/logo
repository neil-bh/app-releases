#!/usr/bin/env python3
"""logo: make apps/<app-id>/logo.png (128 px, square, transparent) from an icon file (.png, .ico, .svg).

  tools/logo <app-id> <source>      then tools/check, and commit the logo with the release that changed the icon
Needs Pillow (and rsvg-convert for .svg)."""
import io
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import applib as L  # noqa: E402


def main(argv):
    if len(argv) != 2:
        print(__doc__.strip().splitlines()[0] + "\nusage: tools/logo <app-id> <source>", file=sys.stderr)
        return 2
    app_id, src = argv
    try:
        L.load_app(app_id)
        from PIL import Image
        if src.lower().endswith(".svg"):
            im = Image.open(io.BytesIO(subprocess.run(["rsvg-convert", "-w", "256", src], capture_output=True, check=True).stdout))
        else:
            im = Image.open(src)
            if src.lower().endswith(".ico"):
                im.size = max(im.info.get("sizes", {im.size}))
        out = os.path.join(L.app_dir(app_id), "logo.png")
        im.convert("RGBA").resize((128, 128), Image.LANCZOS).save(out, optimize=True)
        print(f"wrote {out} ({os.path.getsize(out)} bytes)")
        return 0
    except (L.Problem, OSError, ImportError, subprocess.CalledProcessError) as e:
        print(f"logo: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
